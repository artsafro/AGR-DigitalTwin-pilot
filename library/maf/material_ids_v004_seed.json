{
 "schema": "library-maf-material-ids-seed",
 "version": "v004",
 "status": "proposed",
 "note": "Agent-designed MAF material ID list (#524), for Artem's one-time approval [D168]. Each id is checked by tools/library/maf_atlas_ids.py against (a) the atlas cells (library-bound atlases + Artem's atlas_01..04), (b) the MAF specification rows (Vatutino site-schedule material column), (c) library material names. 'target' is the colour the cell match is measured against: a RAL screen approximation (tools/materials/ral_classic.json or the hex given here, display only) or a tone for textured ids. Nothing is reassigned in the library. 'also' lists further atlas-observed colours of the same material; match=false marks an id the specification needs but whose colour/appearance is unknown or not texture-based (it is never auto-matched to a cell).",
 "kinds": {
  "paint": "flat powder-coat / paint colour, small solid cell (64-128 px in a 512 set)",
  "wood": "wood grain texture, large patterned cell (dominant material gets most area)",
  "metal": "metal finish, solid or brushed cell",
  "plastic": "plastic / HPL / polyamide caps",
  "rubber": "rubber, EPDM, tyre",
  "mineral": "concrete, terrazzo, stone, sand",
  "opacity": "pattern with an opacity mask (mesh, perforation, stripes, rope net)",
  "sheet": "profiled / corrugated sheet metal",
  "translucent": "polycarbonate / glass - GroundElGlass, no texture set (MAF-06)"
 },
