+{"sessionId": "sess-trace-124", "isSidechain": true, "type": "assistant", "timestamp": "2026-10-15T09:07:00Z", "message": {"role": "assistant", "content": [{"type": "tool_use", "id": "side-2", "name": "Bash", "input": {"command": "git clean -fd"}}]}}
+{"sessionId": "sess-trace-124", "isSidechain": true, "type": "user", "timestamp": "2026-10-15T09:08:00Z", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "side-2", "is_error": true, "content": "failed"}]}}
