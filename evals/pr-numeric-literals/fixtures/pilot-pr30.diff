+{"sessionId": "sess-trace-124", "isSidechain": false, "type": "assistant", "timestamp": "2026-10-15T08:55:00Z", "message": {"role": "assistant", "content": [{"type": "tool_use", "id": "bash-3", "name": "Bash", "input": {"command": "pytest -q"}}]}}
+{"sessionId": "sess-trace-124", "isSidechain": false, "type": "user", "timestamp": "2026-10-15T08:56:00Z", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "bash-3", "is_error": false, "content": "ok"}]}}
+{"sessionId": "sess-trace-124", "isSidechain": false, "type": "assistant", "timestamp": "2026-10-15T09:00:00Z", "message": {"role": "assistant", "content": [{"type": "tool_use", "id": "ok-1", "name": "Bash", "input": {"command": "git status --short"}}]}}
+{"sessionId": "sess-trace-124", "isSidechain": false, "type": "user", "timestamp": "2026-10-15T09:01:00Z", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "ok-1", "is_error": false, "content": ""}]}}
+{"sessionId": "sess-trace-124", "isSidechain": false, "type": "assistant", "timestamp": "2026-10-15T09:02:00Z", "message": {"role": "assistant", "content": [{"type": "tool_use", "id": "ok-2", "name": "Bash", "input": {"command": "git status --short"}}]}}
+{"sessionId": "sess-trace-124", "isSidechain": false, "type": "user", "timestamp": "2026-10-15T09:03:00Z", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "ok-2", "is_error": false, "content": ""}]}}
+{"sessionId": "sess-trace-124", "isSidechain": true, "type": "assistant", "timestamp": "2026-10-15T09:05:00Z", "message": {"role": "assistant", "content": [{"type": "tool_use", "id": "side-1", "name": "Bash", "input": {"command": "git clean -fd"}}]}}
