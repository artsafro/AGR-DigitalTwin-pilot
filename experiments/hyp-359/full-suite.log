    @pytest.mark.parametrize("before,edits", [
        ("alpha\nbeta\n", [{"oldText": "alpha", "newText": "beta"}, {"oldText": "beta", "newText": "gamma"}]),
        ("\ufeffalpha\r\nbeta\r\n", [{"oldText": "alpha\nbeta", "newText": "gamma\ndelta"}]),
