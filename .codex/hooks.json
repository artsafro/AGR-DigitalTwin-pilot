{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command|local_shell|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .claude/hooks/guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 tools/hygiene/hygiene.py hook --agent codex",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 tools/hygiene/hygiene.py session --agent codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
