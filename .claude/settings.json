{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree list:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(git lfs ls-files:*)",
      "Bash(git lfs status:*)",
      "Bash(git check-attr:*)",
      "Bash(git check-ignore:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run dt:*)",
      "Bash(uv run python tools/:*)",
      "Bash(python tools/:*)",
      "Bash(py -3 tools/:*)",
      "Bash(py -3 .claude/hooks/:*)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-FileHash *)",
      "mcp__3dsmax-mcp__list_max_instances",
      "mcp__3dsmax-mcp__get_bridge_status",
      "mcp__3dsmax-mcp__capture_viewport",
      "mcp__3dsmax-mcp__query_scene",
      "mcp__blender__get_blendfile_summary_path_info",
      "mcp__blender__get_objects_summary",
      "mcp__blender__get_object_detail_summary",
      "mcp__revit-http-2025__revit_ping",
      "mcp__revit-http-2025__revit_get_document_info",
      "mcp__revit-http-2025__revit_get_view_image",
      "mcp__revit-http-2025__revit_list_elements",
      "mcp__revit-http-2025__revit_list_levels",
      "mcp__revit-http-2025__revit_get_element_info",
      "mcp__revit-http-2025__revit_get_element_geometry",
      "mcp__revit-http-2025__revit_query_where",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__find",
      "WebSearch",
      "WebFetch(domain:dev.epicgames.com)",
      "WebFetch(domain:docs.blender.org)",
      "WebFetch(domain:help.autodesk.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/tools/hooks/session_context.py\" start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/tools/hooks/prompt_hooks.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/tools/hooks/session_context.py\" precompact",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretool.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*(3dsmax|blender|revit).*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/tools/hooks/skill_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(source-inspector|pattern-librarian|bench-runner|independent-checker|mesh-reader)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagents.py\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(source-inspector|pattern-librarian|bench-runner|independent-checker|mesh-reader)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagents.py\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|Task|Skill)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/tools/hooks/usage_log.py\" post",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/tools/state/after_merge.py\" hook",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
