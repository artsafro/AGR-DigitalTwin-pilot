   "link": null,
   "locked": false,
   "text": "Маршрут МАФ (GroundEl, НПМ + ВПМ): событийный штурм (библиотека 931, Ватутино v005 / v006, «Верона») (#1393)",
   "fontSize": 28,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Маршрут МАФ (GroundEl, НПМ + ВПМ): событийный штурм (библиотека 931, Ватутино v005 / v006, «Верона») (#1393)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e33897938687e19e",
   "type": "text",
   "x": 40,
   "y": 44,
   "width": 2300,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
