  {
   "id": "e1f2ab3b278826b9",
   "type": "text",
   "x": 1398,
   "y": 648.75,
   "width": 214,
   "height": 146.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
