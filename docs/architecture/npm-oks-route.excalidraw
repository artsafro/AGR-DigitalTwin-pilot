   "lineHeight": 1.25
  },
  {
   "id": "e33897938687e19e",
   "type": "text",
   "x": 40,
   "y": 44,
   "width": 2300,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
