  {
   "id": "e28d322617be6e05",
   "type": "text",
   "x": 858,
   "y": 1095.25,
   "width": 214,
   "height": 178.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
