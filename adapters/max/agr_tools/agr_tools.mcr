-- Generated by ui_model.macros_ms() (AGR Tools 0.7.0). Own implementation.
-- Every action is a macroScript (toolbar/menu/hotkey) calling the Python runtime.
macroScript AGRToolsOpen category:"AGR Tools" buttonText:"AGR Tools" tooltip:"Открыть панель AGR Tools" iconName:"AgrIcons/agr_tools"
(on execute do (try (python.Execute "agr_tools_runtime.panel()") catch (format "AGR_TOOLS_PANEL_FALLBACK %\n" (getCurrentException()); macros.run "AGR Tools" "AGRToolsClassic")))
macroScript AGRToolsXView category:"AGR Tools" buttonText:"xView: перекрытия" tooltip:"Ищет совпадающие вершины и перекрытые грани; выделяет объекты с ошибками. Треб.: NPM-2.3-7.a, NPM-2.3-9, VPM-2.3-11.a, VPM-2.3-13" iconName:"AgrIcons/agr_xview"
(on execute do python.Execute "agr_tools_runtime.ui('xview')")
macroScript AGRToolsMatID category:"AGR Tools" buttonText:"MatID" tooltip:"Проверяет ID материалов граней против слотов Multi/Sub-Object. Треб.: NPM-2.4-5, VPM-2.4-5" iconName:"AgrIcons/agr_matid"
(on execute do python.Execute "agr_tools_runtime.ui('matid')")
macroScript AGRToolsNames category:"AGR Tools" buttonText:"Имена NPM/VPM" tooltip:"Проверяет имена объектов, материалов и текстур по маскам NPM/VPM (только чтение). Треб.: NPM-2.10-1, NPM-2.10-2, NPM-2.10-3.3.a, VPM-2.10-2.a, VPM-2.11-0.a, VPM-2.11-0.c" iconName:"AgrIcons/agr_names"
(on execute do python.Execute "agr_tools_runtime.ui('names')")
macroScript AGRToolsTris category:"AGR Tools" buttonText:"Треугольники по FBX" tooltip:"Считает треугольники на каждый FBX и сравнивает с лимитом (только чтение). Треб.: NPM-2.3-6.a, NPM-2.3-6.b, VPM-2.3-9, VPM-2.3-10" iconName:"AgrIcons/agr_tris"
(on execute do python.Execute "agr_tools_runtime.ui('tris')")
macroScript AGRToolsTextures category:"AGR Tools" buttonText:"Текстуры (все)" tooltip:"Проверяет формат, размер, альфу и отступы текстур всех объектов (только чтение). Треб.: NPM-2.5-1.a, NPM-2.5-2.a, NPM-2.5-3, NPM-2.5-4, NPM-2.5-5, VPM-2.5-1.2, VPM-2.5-1.5, VPM-2.5-1.6, VPM-2.5-1.9" iconName:"AgrIcons/agr_textures"
(on execute do python.Execute "agr_tools_runtime.ui('textures')")
macroScript AGRToolsPivot category:"AGR Tools" buttonText:"Пивот" tooltip:"Проверяет пивот: Z = 0 и один пивот на FBX, допуск 1 мм (только чтение). Треб.: VPM-2.9-4.b, VPM-2.9-5" iconName:"AgrIcons/agr_pivot"
(on execute do python.Execute "agr_tools_runtime.ui('pivot')")
macroScript AGRToolsNudge category:"AGR Tools" buttonText:"UV-сдвиг (пробно)" tooltip:"Пробный расчёт сдвига UV-островов на целый тайл; сцену не меняет. Треб.: VPM-2.5-2.1.3.a" iconName:"AgrIcons/agr_nudge"
(on execute do python.Execute "agr_tools_runtime.ui('nudge')")
macroScript AGRToolsNudgeApply category:"AGR Tools" buttonText:"UV-сдвиг → копии" tooltip:"Применяет последний пробный UV-сдвиг к новым экспортным копиям; оригиналы не трогает. Треб.: VPM-2.5-2.1.3.a" iconName:"AgrIcons/agr_nudge_apply"
(on execute do python.Execute "agr_tools_runtime.ui('nudge_apply')")
macroScript AGRToolsAtlas category:"AGR Tools" buttonText:"UDIM → атлас (пробно)" tooltip:"Пробная сборка атласа NPM из UDIM-тайлов; сцену не меняет. Треб.: NPM-2.5-4, NPM-2.5-11.a" iconName:"AgrIcons/agr_atlas"
(on execute do python.Execute "agr_tools_runtime.ui('atlas')")
macroScript AGRToolsAtlasApply category:"AGR Tools" buttonText:"Атлас → копии" tooltip:"Применяет последний пробный атлас к новым экспортным копиям; оригиналы не трогает. Треб.: NPM-2.5-4, NPM-2.5-11.a" iconName:"AgrIcons/agr_atlas_apply"
(on execute do python.Execute "agr_tools_runtime.ui('atlas_apply')")
macroScript AGRToolsTexel category:"AGR Tools" buttonText:"Тексель" tooltip:"Показывает минимум и медиану px/m по объектам и материалам (только чтение). Треб.: VPM-2.6-2, NPM-2.6-1" iconName:"AgrIcons/agr_texel"
(on execute do python.Execute "agr_tools_runtime.ui('texel')")
macroScript AGRToolsUcx category:"AGR Tools" buttonText:"UCX (пробно)" tooltip:"Пробный расчёт выпуклых коллизий UCX_; сцену не меняет. Треб.: VPM-2.13-1.a, VPM-2.13-1.b, VPM-2.13-7.a, VPM-2.13-7.b" iconName:"AgrIcons/agr_ucx"
(on execute do python.Execute "agr_tools_runtime.ui('ucx')")
macroScript AGRToolsUcxApply category:"AGR Tools" buttonText:"UCX → копии" tooltip:"Создаёт UCX_-коллизии из последнего пробного расчёта на новых копиях. Треб.: VPM-2.13-1.a, VPM-2.13-1.b, VPM-2.13-7.a, VPM-2.13-7.b" iconName:"AgrIcons/agr_ucx_apply"
(on execute do python.Execute "agr_tools_runtime.ui('ucx_apply')")
macroScript AGRToolsCleanup category:"AGR Tools" buttonText:"Очистка (пробно)" tooltip:"Пробная очистка перед экспортом: каналы UV, свойства, атрибуты; сцену не меняет. Треб.: VPM-2.3-11.e" iconName:"AgrIcons/agr_cleanup"
(on execute do python.Execute "agr_tools_runtime.ui('cleanup')")
macroScript AGRToolsCleanupApply category:"AGR Tools" buttonText:"Очистка → копии" tooltip:"Применяет последнюю пробную очистку к новым экспортным копиям. Треб.: VPM-2.3-11.e" iconName:"AgrIcons/agr_cleanup_apply"
(on execute do python.Execute "agr_tools_runtime.ui('apply')")
macroScript AGRToolsExport category:"AGR Tools" buttonText:"Экспорт с проверкой" tooltip:"Первое нажатие: пробный экспорт и все проверки; второе на том же выделении пишет FBX. Треб.: NPM-1.1-1, VPM-1.1-1, NPM-2.1-3.c" iconName:"AgrIcons/agr_export"
(on execute do python.Execute "agr_tools_runtime.ui('export')")
macroScript AGRToolsGeojson category:"AGR Tools" buttonText:"Проверка GeoJSON" tooltip:"Проверяет паспорт GeoJSON проверяющим модулем twinqa (выбор файла). Треб.: GJ-1, GJ-2, GJ-3, VPM-2.2-1" iconName:"AgrIcons/agr_geojson"
(on execute do python.Execute "agr_tools_runtime.ui('geojson')")
macroScript AGRToolsCensus category:"AGR Tools" buttonText:"Перепись сцены" tooltip:"Перепись: классы объектов, материалы, карты, пропавшие файлы, bbox, инстансы (только чтение). Треб.: NPM-2.1-1.b, VPM-2.1-1.c" iconName:"AgrIcons/agr_census"
(on execute do python.Execute "agr_tools_runtime.ui('census')")
macroScript AGRToolsUnits category:"AGR Tools" buttonText:"Единицы и гамма" tooltip:"Проверяет System Unit = метры, масштаб 1, гамму файлов 1.0 (только чтение). Треб.: NPM-1.2-1, VPM-1.2-1" iconName:"AgrIcons/agr_units"
(on execute do python.Execute "agr_tools_runtime.ui('units')")
macroScript AGRToolsPerimeterDrop category:"AGR Tools" buttonText:"Опуск периметра ≥1 м" tooltip:"Нижняя точка ОКС/Ground не меньше 1 м ниже ±0.000 (AGR_ZERO_M) (только чтение). Треб.: NPM-2.3-4, VPM-2.3-6, VPM-2.3-7.a" iconName:"AgrIcons/agr_drop"
(on execute do python.Execute "agr_tools_runtime.ui('perimeter_drop')")
macroScript AGRToolsMaterialType category:"AGR Tools" buttonText:"Тип материала" tooltip:"Только Standard/Physical; Corona, VRay и другие — ошибка с именем материала (только чтение). Треб.: NPM-2.4-1.a, NPM-2.4-1.b, VPM-2.4-1.a, VPM-2.4-1.b" iconName:"AgrIcons/agr_mattype"
(on execute do python.Execute "agr_tools_runtime.ui('material_type')")
macroScript AGRToolsUcxAudit category:"AGR Tools" buttonText:"UCX: аудит сцены" tooltip:"Готовые UCX_: замкнутость, выпуклость, без материалов, имя, пересечения SAT, бюджет (только чтение). Треб.: VPM-2.13-1.a, VPM-2.13-1.b, VPM-2.13-1.c, VPM-2.13-1.d, VPM-2.13-3, VPM-2.13-4.a, VPM-2.13-7.a, VPM-2.13-7.b" iconName:"AgrIcons/agr_ucxaudit"
(on execute do python.Execute "agr_tools_runtime.ui('ucx_audit')")
macroScript AGRToolsSetsCount category:"AGR Tools" buttonText:"Число текстурных наборов" tooltip:"Наборы на FBX: ОКС ≤40 (+1 кровля), Ground ≤20, GroundEl 1, Flora 1 (только чтение). Треб.: NPM-2.1-4.c, NPM-2.1-5.b, NPM-2.5-11.a, NPM-2.5-11.b" iconName:"AgrIcons/agr_setscount"
(on execute do python.Execute "agr_tools_runtime.ui('sets_count')")
macroScript AGRToolsFbxSplit category:"AGR Tools" buttonText:"Разделение FBX" tooltip:"ОКС ≤20 FBX, ≤20 объектов на FBX, Ground обязателен, нумерация сквозная (только чтение). Треб.: NPM-2.1-2, NPM-2.1-4.a, NPM-2.1-6, NPM-2.2-1, NPM-2.2-4, VPM-2.1-3.a, VPM-2.1-4" iconName:"AgrIcons/agr_split"
(on execute do python.Execute "agr_tools_runtime.ui('fbx_split')")
macroScript AGRToolsGlass category:"AGR Tools" buttonText:"Стекло" tooltip:"Стекло на отдельном *Glass, ≤20 прозрачных, ≤7 материалов, без карт, 50 % (только чтение). Треб.: NPM-2.7-2, NPM-2.1-4.b, NPM-2.4-2, NPM-2.4-3.b, NPM-2.4-6, VPM-2.8-1, VPM-2.8-2, VPM-2.3-4" iconName:"AgrIcons/agr_glasscheck"
(on execute do python.Execute "agr_tools_runtime.ui('glass')")
macroScript AGRToolsSceneHygiene category:"AGR Tools" buttonText:"Лишнее в сцене" tooltip:"Камеры, свет, кости, анимация, группы и иерархия, пустые объекты, модификаторы (только чтение). Треб.: NPM-2.1-3.a, NPM-2.1-3.b, NPM-2.1-3.c, NPM-2.1-3.d, NPM-2.3-5, VPM-2.3-1, VPM-2.3-2, VPM-2.3-8, VPM-2.3-11.d, VPM-2.3-11.e" iconName:"AgrIcons/agr_hygiene"
(on execute do python.Execute "agr_tools_runtime.ui('scene_hygiene')")
macroScript AGRToolsXform category:"AGR Tools" buttonText:"Трансформы сброшены" tooltip:"Несброшенный масштаб, поворот, зеркало и родители; сброс только на копиях (только чтение). Треб.: NPM-2.3-14, VPM-2.3-18" iconName:"AgrIcons/agr_xform"
(on execute do python.Execute "agr_tools_runtime.ui('xform')")
macroScript AGRToolsZeroArea category:"AGR Tools" buttonText:"Нулевые площади и рёбра" tooltip:"Грани нулевой площади, рёбра нулевой длины, изолированные вершины (только чтение). Треб.: NPM-2.3-7.b, NPM-2.3-7.c, VPM-2.3-11.b, VPM-2.3-11.c" iconName:"AgrIcons/agr_zero"
(on execute do python.Execute "agr_tools_runtime.ui('zero_area')")
macroScript AGRToolsPreflight category:"AGR Tools" buttonText:"Предсдача: все проверки" tooltip:"Все проверки 0.7 одним нажатием, одна таблица; сцена не меняется. Треб.: NPM-2.1-3.c, VPM-2.3-1" iconName:"AgrIcons/agr_preflight"
(on execute do python.Execute "agr_tools_runtime.ui('preflight')")
macroScript AGRToolsMissingMaps category:"AGR Tools" buttonText:"Пропавшие карты" tooltip:"Список битмапов с несуществующим путём и кандидаты для relink; файлы не переименовываются (только чтение). Треб.: NPM-2.1-1.b, VPM-2.4-2" iconName:"AgrIcons/agr_missing"
(on execute do python.Execute "agr_tools_runtime.ui('scene.missing_maps')")
macroScript AGRToolsTriangulate category:"AGR Tools" buttonText:"Триангуляция → копии" tooltip:"Первое нажатие: пробно; второе на том же выделении триангулирует n-гоны на экспортных копиях. Треб.: NPM-2.3-11, VPM-2.3-17" iconName:"AgrIcons/agr_triangulate"
(on execute do python.Execute "agr_tools_runtime.ui('model.triangulate')")
macroScript AGRToolsFormatFix category:"AGR Tools" buttonText:"PNG: формат → новые файлы" tooltip:"Пробно, затем пишет исправленные PNG в новую папку: без альфы, 24 бит, до лимита; исходники не трогает. Треб.: NPM-2.5-2.a, NPM-2.5-3, NPM-2.5-5, VPM-2.5-1.6, VPM-2.5-1.9" iconName:"AgrIcons/agr_pngfix"
(on execute do python.Execute "agr_tools_runtime.ui('tex.format_fix')")
macroScript AGRToolsPlaceholders category:"AGR Tools" buttonText:"Заглушки 256 / 128" tooltip:"Пробно, затем создаёт новые однотонные заглушки Diffuse/ERM/Normal нужного размера и цвета. Треб.: VPM-2.5-3.1, VPM-2.5-3.3, VPM-2.5-3.4, NPM-2.5-7" iconName:"AgrIcons/agr_plug"
(on execute do python.Execute "agr_tools_runtime.ui('tex.placeholders')")
macroScript AGRToolsUcxTriangulate category:"AGR Tools" buttonText:"UCX: триангуляция → копии" tooltip:"Пробно, затем триангулирует UCX на копиях и проверяет выпуклость после. Треб.: VPM-2.3-17, VPM-2.13-1.a" iconName:"AgrIcons/agr_ucxtri"
(on execute do python.Execute "agr_tools_runtime.ui('ucx.triangulate')")
macroScript AGRToolsUcxRename category:"AGR Tools" buttonText:"UCX: имена" tooltip:"Пробно, затем переименовывает куски в UCX_SM_<Address>_Main/Ground_NNN одной записью Undo. Треб.: VPM-2.13-1.d, VPM-2.10-4.2.b" iconName:"AgrIcons/agr_ucxname"
(on execute do python.Execute "agr_tools_runtime.ui('ucx.rename')")
macroScript AGRToolsIdsToUdims category:"AGR Tools" buttonText:"ID → UDIM на копии" tooltip:"Пробно, затем раскладывает материал ID n в тайл 1000+n на экспортных копиях. Треб.: VPM-2.5-2.1.3.a, VPM-2.5-2.1.3.b" iconName:"AgrIcons/agr_id2udim"
(on execute do python.Execute "agr_tools_runtime.ui('udim.ids_to_udims')")
macroScript AGRToolsNamesFix category:"AGR Tools" buttonText:"Исправить имена → копии" tooltip:"Пробно, затем переименовывает объекты, материалы и файлы карт по маске на экспортных копиях. Треб.: NPM-2.10-3.3.a, NPM-2.10-3.4.a, VPM-2.11-0.a, VPM-2.10-4.3" iconName:"AgrIcons/agr_namefix"
(on execute do python.Execute "agr_tools_runtime.ui('qa.names_fix')")
macroScript AGRToolsPackage category:"AGR Tools" buttonText:"Проверка пакета ZIP" tooltip:"ZIP: размеры, состав FBX/PNG/GeoJSON, имена, битые файлы, readback (только чтение). Треб.: NPM-2.1-1.a, NPM-2.1-1.b, VPM-2.1-1.a, VPM-2.1-1.b, VPM-2.1-2.a, VPM-2.1-2.c, VPM-2.1-2.d" iconName:"AgrIcons/agr_package"
(on execute do python.Execute "agr_tools_runtime.ui('qa.package')")
macroScript AGRToolsGeojsonWrite category:"AGR Tools" buttonText:"Паспорт GeoJSON → новый файл" tooltip:"Пробно, затем пишет новый GeoJSON из сцены (пивот, положение, адрес, превью) и сразу проверяет. Треб.: VPM-2.2-1, VPM-2.2-2, VPM-2.2-6.a, VPM-2.2-7, GJ-1, GJ-19.a, GJ-19.b, GJ-21.a, VPM-2.10-4.1.e" iconName:"AgrIcons/agr_geojsonw"
(on execute do python.Execute "agr_tools_runtime.ui('export.geojson_write')")
macroScript AGRToolsGroundFbx category:"AGR Tools" buttonText:"FBX благоустройства" tooltip:"Пробно, затем пишет новый _Ground.fbx: Ground, GroundEl, Flora, GroundGlass в одном файле. Треб.: NPM-2.1-5.a, VPM-2.1-4" iconName:"AgrIcons/agr_groundfbx"
(on execute do python.Execute "agr_tools_runtime.ui('export.ground_fbx')")
macroScript AGRToolsPivotPlace category:"AGR Tools" buttonText:"Пивот и положение → копии" tooltip:"Пробно, затем ставит пивот на копиях: НПМ в МСК с высотами, ВПМ в ноль (чистый пол). Треб.: NPM-2.8-1, NPM-2.8-2, VPM-2.9-4.b, VPM-2.9-5" iconName:"AgrIcons/agr_place"
(on execute do python.Execute "agr_tools_runtime.ui('export.pivot_place')")
macroScript AGRToolsZip category:"AGR Tools" buttonText:"Архив пакета → новый ZIP" tooltip:"Пробно, затем пишет новый ZIP НПМ/ВПМ с лимитами 500 МБ / 1 ГБ, проверка до и после. Треб.: NPM-2.1-1.a, VPM-2.1-1.a, VPM-2.1-1.b, VPM-2.1-2.b" iconName:"AgrIcons/agr_zip"
(on execute do python.Execute "agr_tools_runtime.ui('export.zip')")
macroScript AGRToolsClassic category:"AGR Tools" tooltip:"AGR Tools (classic rollout)" buttonText:"AGR Tools (classic)"
(
    on execute do (
        global AGRToolsDialog
        try (destroyDialog AGRToolsDialog) catch ()
        rollout AGRToolsDialog "AGR Tools" width:360 (
            button b_xview "xView: перекрытия" width:340
            button b_matid "MatID" width:340
            button b_names "Имена NPM/VPM" width:340
            button b_tris "Треугольники по FBX" width:340
            button b_textures "Текстуры (все)" width:340
            button b_pivot "Пивот" width:340
            button b_nudge "UV-сдвиг (пробно)" width:340
            button b_nudge_apply "UV-сдвиг → копии" width:340
            button b_atlas "UDIM → атлас (пробно)" width:340
            button b_atlas_apply "Атлас → копии" width:340
            button b_texel "Тексель" width:340
            button b_ucx "UCX (пробно)" width:340
            button b_ucx_apply "UCX → копии" width:340
            button b_cleanup "Очистка (пробно)" width:340
            button b_cleanup_apply "Очистка → копии" width:340
            button b_export "Экспорт с проверкой" width:340
            button b_geojson "Проверка GeoJSON" width:340
            button b_census "Перепись сцены" width:340
            button b_units "Единицы и гамма" width:340
            button b_perimeter_drop "Опуск периметра ≥1 м" width:340
            button b_material_type "Тип материала" width:340
            button b_ucx_audit "UCX: аудит сцены" width:340
            button b_sets_count "Число текстурных наборов" width:340
            button b_fbx_split "Разделение FBX" width:340
            button b_glass "Стекло" width:340
            button b_scene_hygiene "Лишнее в сцене" width:340
            button b_xform "Трансформы сброшены" width:340
            button b_zero_area "Нулевые площади и рёбра" width:340
            button b_preflight "Предсдача: все проверки" width:340
            button b_missing_maps "Пропавшие карты" width:340
            button b_triangulate "Триангуляция → копии" width:340
            button b_format_fix "PNG: формат → новые файлы" width:340
            button b_placeholders "Заглушки 256 / 128" width:340
            button b_ucx_triangulate "UCX: триангуляция → копии" width:340
            button b_ucx_rename "UCX: имена" width:340
            button b_ids_to_udims "ID → UDIM на копии" width:340
            button b_names_fix "Исправить имена → копии" width:340
            button b_package "Проверка пакета ZIP" width:340
            button b_geojson_write "Паспорт GeoJSON → новый файл" width:340
            button b_ground_fbx "FBX благоустройства" width:340
            button b_pivot_place "Пивот и положение → копии" width:340
            button b_zip "Архив пакета → новый ZIP" width:340
            label info "JSON report in Listener; checks select offenders."
            on b_xview pressed do python.Execute "agr_tools_runtime.ui('xview')"
            on b_matid pressed do python.Execute "agr_tools_runtime.ui('matid')"
            on b_names pressed do python.Execute "agr_tools_runtime.ui('names')"
            on b_tris pressed do python.Execute "agr_tools_runtime.ui('tris')"
            on b_textures pressed do python.Execute "agr_tools_runtime.ui('textures')"
            on b_pivot pressed do python.Execute "agr_tools_runtime.ui('pivot')"
            on b_nudge pressed do python.Execute "agr_tools_runtime.ui('nudge')"
            on b_nudge_apply pressed do python.Execute "agr_tools_runtime.ui('nudge_apply')"
            on b_atlas pressed do python.Execute "agr_tools_runtime.ui('atlas')"
            on b_atlas_apply pressed do python.Execute "agr_tools_runtime.ui('atlas_apply')"
            on b_texel pressed do python.Execute "agr_tools_runtime.ui('texel')"
            on b_ucx pressed do python.Execute "agr_tools_runtime.ui('ucx')"
            on b_ucx_apply pressed do python.Execute "agr_tools_runtime.ui('ucx_apply')"
            on b_cleanup pressed do python.Execute "agr_tools_runtime.ui('cleanup')"
            on b_cleanup_apply pressed do python.Execute "agr_tools_runtime.ui('apply')"
            on b_export pressed do python.Execute "agr_tools_runtime.ui('export')"
            on b_geojson pressed do python.Execute "agr_tools_runtime.ui('geojson')"
            on b_census pressed do python.Execute "agr_tools_runtime.ui('census')"
            on b_units pressed do python.Execute "agr_tools_runtime.ui('units')"
            on b_perimeter_drop pressed do python.Execute "agr_tools_runtime.ui('perimeter_drop')"
            on b_material_type pressed do python.Execute "agr_tools_runtime.ui('material_type')"
            on b_ucx_audit pressed do python.Execute "agr_tools_runtime.ui('ucx_audit')"
            on b_sets_count pressed do python.Execute "agr_tools_runtime.ui('sets_count')"
            on b_fbx_split pressed do python.Execute "agr_tools_runtime.ui('fbx_split')"
            on b_glass pressed do python.Execute "agr_tools_runtime.ui('glass')"
            on b_scene_hygiene pressed do python.Execute "agr_tools_runtime.ui('scene_hygiene')"
            on b_xform pressed do python.Execute "agr_tools_runtime.ui('xform')"
            on b_zero_area pressed do python.Execute "agr_tools_runtime.ui('zero_area')"
            on b_preflight pressed do python.Execute "agr_tools_runtime.ui('preflight')"
            on b_missing_maps pressed do python.Execute "agr_tools_runtime.ui('scene.missing_maps')"
            on b_triangulate pressed do python.Execute "agr_tools_runtime.ui('model.triangulate')"
            on b_format_fix pressed do python.Execute "agr_tools_runtime.ui('tex.format_fix')"
            on b_placeholders pressed do python.Execute "agr_tools_runtime.ui('tex.placeholders')"
            on b_ucx_triangulate pressed do python.Execute "agr_tools_runtime.ui('ucx.triangulate')"
            on b_ucx_rename pressed do python.Execute "agr_tools_runtime.ui('ucx.rename')"
            on b_ids_to_udims pressed do python.Execute "agr_tools_runtime.ui('udim.ids_to_udims')"
            on b_names_fix pressed do python.Execute "agr_tools_runtime.ui('qa.names_fix')"
            on b_package pressed do python.Execute "agr_tools_runtime.ui('qa.package')"
            on b_geojson_write pressed do python.Execute "agr_tools_runtime.ui('export.geojson_write')"
            on b_ground_fbx pressed do python.Execute "agr_tools_runtime.ui('export.ground_fbx')"
            on b_pivot_place pressed do python.Execute "agr_tools_runtime.ui('export.pivot_place')"
            on b_zip pressed do python.Execute "agr_tools_runtime.ui('export.zip')"
        )
        createDialog AGRToolsDialog
    )
)
