{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExportMeta",
  "description": "Shared export metadata; unknown denotes unavailable source evidence, never approval. Legacy three-field records remain readable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["address", "h_otn_model_max_z_m", "thumbnail"],
  "$defs": {"xyz": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
  "properties": {
    "fbx_records": {"description": "#1342: exact FBX filename -> world bounds_m of render (non-UCX) geometry in the exported frame + SHA-256 of the written FBX bytes; consumed by validate_package --export-meta (V013).",
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9_]+\\.fbx$"},
      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["bounds_m", "fbx_sha256"],
        "properties": {"bounds_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/xyz"}},
                       "fbx_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "fbx": {"type": "string", "pattern": "\\S"},
    "pivot_revit_internal_m": {"$ref": "#/$defs/xyz"},
    "bbox_after_pivot": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/xyz"}},
    "main_tris": {"type": "integer", "minimum": 0},
    "glass_tris": {"type": "integer", "minimum": 0},
    "ucx": {"type": "integer", "minimum": 0},
    "ucx_tris": {"type": "integer", "minimum": 0},
    "address": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:_[A-Za-z0-9]+)*$", "not": {"pattern": "\\s"}},
    "h_otn_model_max_z_m": {"oneOf": [{"type": "number"}, {"const": "unknown"}]},
    "thumbnail": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "profile": {"enum": ["npm", "vpm", "unknown"]},
    "exported_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+\\.fbx$", "not": {"pattern": "\\s"}}},
    "provenance": {"type": "object", "additionalProperties": false, "properties": {
      "fbx": {"type": "string", "pattern": "\\S"},
      "pivot_revit_internal_m": {"type": "string", "pattern": "\\S"},
      "bbox_after_pivot": {"type": "string", "pattern": "\\S"},
      "main_tris": {"type": "string", "pattern": "\\S"},
      "glass_tris": {"type": "string", "pattern": "\\S"},
      "ucx": {"type": "string", "pattern": "\\S"},
      "ucx_tris": {"type": "string", "pattern": "\\S"},
      "address": {"type": "string", "pattern": "\\S"},
      "h_otn_model_max_z_m": {"type": "string", "pattern": "\\S"},
      "thumbnail": {"type": "string", "pattern": "\\S"},
      "profile": {"type": "string", "pattern": "\\S"},
      "exported_files": {"type": "string", "pattern": "\\S"}
    }, "required": ["address", "h_otn_model_max_z_m", "thumbnail"]}
  }
}
