{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Budgeted PDF album index (paper coordinates, unapproved candidates)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "page_count", "pages"],
  "properties": {
    "schema": {"const": "album-index/1"},
    "source": {"$ref": "#/$defs/source"},
    "page_count": {"type": "integer", "minimum": 1},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "bytes", "frozen_file"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "frozen_file": {"const": "source.pdf"}
      }
    },
    "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["region_id", "bbox", "indicator", "label", "route", "reason"],
      "properties": {
        "region_id": {"type": "string", "pattern": "^p[1-9][0-9]*-r[1-9][0-9]*$"},
        "bbox": {"$ref": "#/$defs/box"},
        "indicator": {"enum": ["text", "vector", "raster", "outline_candidate", "unknown"]},
        "label": {"type": ["string", "null"]},
        "route": {"enum": ["vector_read", "table_extraction", "ocr_vision"]},
        "reason": {"type": "string", "minLength": 1},
        "operations": {"type": "integer", "minimum": 1}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["pdf_page", "printed_sheet", "title", "kind", "kind_status", "status", "reason", "scale", "units", "regions"],
      "properties": {
        "pdf_page": {"type": "integer", "minimum": 1},
        "printed_sheet": {"type": ["string", "null"]},
        "title": {"type": ["string", "null"]},
        "kind": {"enum": ["plan", "facade", "section", "schedule", "3D", "unknown"]},
        "kind_status": {"enum": ["text_heuristic_unapproved", "unresolved"]},
        "status": {"enum": ["indexed", "partial"]},
        "reason": {"type": ["string", "null"]},
        "scale": {"const": "unknown"},
        "units": {"type": "null"},
        "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
        "size_pt": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "partial"}}},
         "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "indexed"}}},
         "then": {"properties": {"reason": {"type": "null"}, "regions": {"minItems": 1}}}}
      ]
    }
  }
}
