{
  "$defs": {
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "parts_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gate 1: PartsList.approval_sha256(), excluding gate1/status; not file bytes",
          "not": {
            "pattern": "\\s",
            "type": "string"
          },
          "title": "Parts Sha256"
        },
        "ref": {
          "anyOf": [
            {
              "pattern": "^(https://\\S+|t_[0-9a-f]+|D[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "not": {
            "pattern": "\\s",
            "type": "string"
          },
          "title": "Ref"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "synthetic_fixture",
            "project"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "date",
        "scope",
        "note"
      ],
      "title": "Approval",
      "type": "object"
    },
    "HeightSource": {
      "additionalProperties": false,
      "description": "File plus sheet/cell, level or drawing handle; never infer a vertical CRS from MSK-77.",
      "properties": {
        "file": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Locator",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "file",
        "locator"
      ],
      "title": "HeightSource",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "project_zero_m": {
                "type": "number"
              }
            },
            "required": [
              "project_zero_m"
            ]
          },
          "then": {
            "properties": {
              "height_source": {
                "type": "object"
              },
              "height_system": {
                "enum": [
                  "BSV-77",
                  "Baltic 1977",
                  "MSK local",
                  "unknown"
                ]
              }
            },
            "required": [
              "height_system",
              "height_source"
            ]
          }
        }
      ],
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Approval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coordinate_system": {
          "enum": [
            "SYNTHETIC_LOCAL",
            "MSK-77"
          ],
          "title": "Coordinate System",
          "type": "string"
        },
        "ground_mark_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ground Mark M"
        },
        "ground_mark_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeightSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "height_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeightSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "height_system": {
          "anyOf": [
            {
              "enum": [
                "BSV-77",
                "Baltic 1977",
                "MSK local",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height System"
        },
        "insertion_xy": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Insertion Xy"
        },
        "project_zero_fbx_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeightSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_zero_fbx_z_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Zero Fbx Z M"
        },
        "project_zero_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Zero M"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "status": {
          "enum": [
            "unknown",
            "proposed",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "coordinate_system",
        "source",
        "status"
      ],
      "title": "Placement",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "pdf",
            "model",
            "user",
            "drawing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "sheet": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "address_token": {
      "maxLength": 120,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "title": "Address Token",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "title": "Inputs",
      "type": "object"
    },
    "placement": {
      "$ref": "#/$defs/Placement"
    },
    "profile_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "NPM",
          "VPM"
        ]
      },
      "title": "Profile Versions",
      "type": "object"
    },
    "project_id": {
      "maxLength": 120,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "standards_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Standards Sha256",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "synthetic",
    "address_token",
    "standards_sha256",
    "profile_versions",
    "inputs",
    "placement"
  ],
  "title": "ProjectManifest",
  "type": "object"
}
